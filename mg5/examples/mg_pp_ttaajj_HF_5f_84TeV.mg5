import model loop_sm-no_b_mass

define top = t t~

generate p p > top top a a b b~ QCD=4 QED=2
add process p p > top top a a c c~ QCD=4 QED=2

output DUMMYPROCESS

######## DELIMITER (!!! NEED THIS LINE !!!) ##################

set lhapdf /afs/cern.ch/work/b/bistapf/lhapdf/LHAPDF-6.1.6/install/bin/lhapdf-config

launch DUMMYPROCESS

set iseed DUMMYSEED
set nevents DUMMYNEVENTS

set ebeam1 42000
set ebeam2 42000

set pdlabel lhapdf
set lhaid 260000

set maxjetflavor 5

set mmaa 105.0
set mmaamax 145.0

set ptb 20
set etab 5.0
set drbb 0.4
set drbj 0.4
set pta 20
set etaa 5.0
set draa 0.1
set drab 0.1

set use_syst False