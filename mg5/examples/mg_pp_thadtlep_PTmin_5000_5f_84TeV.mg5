import model sm-no_b_mass
define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
define ell = e+ mu+ ta+ e- mu- ta-
define nu =  ve vm vt ve~ vm~ vt~
define w = w+ w-
define top = t t~
define bottom = b b~
define wpm = w+ w-
define lepm = ve~ vm~ vt~ e- mu- ta-
define lepp = ve vm vt e+ mu+ ta+
define all_p = ve vm vt e+ mu+ ta+ g u c d s b u~ c~ d~ s~ b~
define v = w z

generate p p > top top
output DUMMYPROCESS

######## DELIMITER (!!! NEED THIS LINE !!!) ##################

launch DUMMYPROCESS

MADSPIN=onshell

set iseed DUMMYSEED
set nevents DUMMYNEVENTS

set ebeam1 42000
set ebeam2 42000
set ptheavy 5000.0

decay t > w+ b, w+ > j j 
decay t~ > w- b~, w- > lepm lepm

done
